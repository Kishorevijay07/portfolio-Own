# ── OpenRouter (the "AI mind") ──────────────────────────────────────────────
# Create a key at https://openrouter.ai/keys and paste it here (locally) or in
# the Render dashboard (production). NEVER commit the real key.
OPENROUTER_API_KEY=sk-or-your-key-here

# Any OpenRouter chat model id. Free models end in ":free" (limits apply).
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# ── RAG / embeddings ─────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=4

# ── Optional: shown to OpenRouter for attribution / rankings ─────────────────
SITE_URL=
SITE_NAME=Kishore Portfolio Assistant

# ── Safety ───────────────────────────────────────────────────────────────────
MAX_QUESTION_CHARS=500
