# ── Gemini (Google AI Studio — the "AI mind") ───────────────────────────────
# Create a FREE key at https://aistudio.google.com/apikey and paste it here
# (locally) or in the Render dashboard (production). NEVER commit the real key.
GEMINI_API_KEY=your-gemini-key-here

# Any Gemini model id. Free-tier "flash" models are a good default.
# List models available to your key:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
GEMINI_MODEL=gemini-2.5-flash

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# ── RAG / embeddings ─────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=6

# ── Optional: shown to OpenRouter for attribution / rankings ─────────────────
SITE_URL=
SITE_NAME=Kishore Portfolio Assistant

# ── Safety ───────────────────────────────────────────────────────────────────
MAX_QUESTION_CHARS=500
MAX_CONTACT_CHARS=3000

# ── GitHub stats (cached, powers the portfolio counters) ─────────────────────
GITHUB_USERNAME=kishorevijay07
GITHUB_CACHE_TTL=3600
# Optional, for a higher GitHub API rate limit (not required):
# GITHUB_TOKEN=

# ── Contact form email ───────────────────────────────────────────────────────
# Option A (recommended): Resend — https://resend.com → API key
RESEND_API_KEY=
CONTACT_TO_EMAIL=kishore.tech.codes@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Option B: SMTP (e.g. Gmail app password) — used only if RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
