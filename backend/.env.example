# ── OpenRouter (the "AI mind") ──────────────────────────────────────────────
# Create a key at https://openrouter.ai/keys and paste it here (locally) or in
# the Render dashboard (production). NEVER commit the real key.
OPENROUTER_API_KEY=sk-or-your-key-here

# Any OpenRouter chat model id. Free models end in ":free" (daily rate limits
# apply; adding ~$10 credit to OpenRouter raises the free limits substantially).
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Fallback routing (comma-separated, max 3): OpenRouter tries them in order.
# Recommended for flaky free models. Leave blank to use OPENROUTER_MODEL only.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# ── RAG / embeddings ─────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=6

# ── Optional: shown to OpenRouter for attribution / rankings ─────────────────
SITE_URL=
SITE_NAME=Kishore Portfolio Assistant

# ── Safety ───────────────────────────────────────────────────────────────────
MAX_QUESTION_CHARS=500
MAX_CONTACT_CHARS=3000

# ── GitHub stats (cached, powers the portfolio counters) ─────────────────────
GITHUB_USERNAME=kishorevijay07
GITHUB_CACHE_TTL=3600
# Optional, for a higher GitHub API rate limit (not required):
# GITHUB_TOKEN=

# ── Contact form email ───────────────────────────────────────────────────────
# Option A (recommended): Resend — https://resend.com → API key
RESEND_API_KEY=
CONTACT_TO_EMAIL=kishore.tech.codes@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Option B: SMTP (e.g. Gmail app password) — used only if RESEND_API_KEY is empty
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
